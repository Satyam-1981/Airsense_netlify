# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (create the database before running migrations)
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/atmoiq

# Optional monitoring-station data providers
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
OPENAQ_API_KEY=

# Generated by `python ml/train.py`; do not commit model binaries
ML_ARTIFACT_PATH=ml/artifacts/atmoiq_models.joblib
ML_METRICS_PATH=ml/artifacts/metrics.json
