# Frontend: public URL of the Python FastAPI service (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Python backend environment (set these in the backend host, not in VITE_ vars)
OPENAQ_API_KEY=
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
# Comma-separated allowed frontend origins. Use * for local development only.
CORS_ORIGINS=http://localhost:5173
